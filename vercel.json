{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/ingest", "schedule": "0 18 * * *" },
    { "path": "/api/enrich?limit=1500", "schedule": "0 19 * * *" }
  ]
}
