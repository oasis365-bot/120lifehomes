# ── 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 커밋되지 않음) ──
# 운영 환경에서는 Vercel 프로젝트 Settings → Environment Variables 에 동일하게 입력합니다.

# Supabase  (Supabase 프로젝트 → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 서버 키 — 아래 중 하나만 채우면 됨 (SECRET_KEY 우선, 없으면 SERVICE_ROLE_KEY fallback):
#   · 신규 프로젝트: API Keys 의 "secret" 키
SUPABASE_SECRET_KEY=sb_secret_...
#   · legacy 프로젝트: "service_role" JWT
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# 공공데이터포털 - 국민건강보험공단 장기요양기관 검색 서비스
#   마이페이지 → 오픈API → 인증키 의 "일반 인증키(Decoding)" 값
DATA_GO_KR_KEY=

# (선택) 수집 API 수동 호출/크론 보호용 임의 문자열. 아무 길고 랜덤한 값.
CRON_SECRET=change-me-to-a-long-random-string

# (선택) 공공 API 오퍼레이션 경로가 다를 경우 덮어쓰기. 기본값은 api/ingest.js 참고.
# DATA_GO_KR_OP=getLtcInsttSearchList

# ── 요양병원(HIRA) 실 적재 — 승인된 시험/적재 시에만, Preview 스코프에만 설정 ──
#  둘 다 있어야 /api/hospital/ingest?dryRun=false 가 DB 에 쓴다. 미설정이면 fail-closed(쓰지 않음).
#  production 스코프에는 절대 설정하지 않는다 (production 은 어차피 404).
# HOSPITAL_INGEST_PERSIST=1
# HOSPITAL_INGEST_DB_HOST=<적재 허용 Supabase hostname, 예: your-preview-ref.supabase.co>
#  (요양병원 수집 자체는 위 DATA_GO_KR_KEY 를 그대로 쓴다. 없으면 비활성.)
