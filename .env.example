# ── 이 파일을 복사해 .env 로 만들고 값을 채우세요 (.env 는 커밋되지 않음) ──
# 운영 환경에서는 Vercel 프로젝트 Settings → Environment Variables 에 동일하게 입력합니다.

# Supabase  (Supabase 프로젝트 → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...

# 공공데이터포털 - 국민건강보험공단 장기요양기관 검색 서비스
#   마이페이지 → 오픈API → 인증키 의 "일반 인증키(Decoding)" 값
DATA_GO_KR_KEY=

# (선택) 수집 API 수동 호출/크론 보호용 임의 문자열. 아무 길고 랜덤한 값.
CRON_SECRET=change-me-to-a-long-random-string

# (선택) 공공 API 오퍼레이션 경로가 다를 경우 덮어쓰기. 기본값은 api/ingest.js 참고.
# DATA_GO_KR_OP=getLtcInsttSearchList
